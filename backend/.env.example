# 本文件只是「有哪些可配项」的示例，程序不会自动读取它。
# 日常本机开发：直接改 application.properties 里的默认值即可。
# 只有不想改 properties、又要临时覆盖时，才在当前 PowerShell 里设环境变量，例如：
#   $env:WX_APPID="你的appid"
#   $env:WX_SECRET="你的secret"
#   $env:DB_PASSWORD="你的数据库密码"
# 然后再 mvn spring-boot:run（变量只对这个终端窗口有效）。

WX_APPID=
WX_SECRET=
DB_URL=jdbc:mysql://localhost:3306/home_ordering?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false
DB_USERNAME=root
DB_PASSWORD=root
SERVER_URL=http://localhost:8080
FILE_UPLOAD_PATH=./uploads/
